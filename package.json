{
  "name": "sorcerers-tower",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "hal": "node scripts/fetch-hal.mjs",
    "spike:check": "tsc -p spike",
    "spike:build": "tsc -p spike && vite build -c vite.spike.config.ts",
    "spike:model": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup --python spike/blender/model_library.py -- spike/public",
    "spike:render": "node spike/tools/render.mjs"
  },
  "dependencies": {
    "animejs": "^3.2.2",
    "three": "^0.184.0",
    "vgpu": "^0.5.0",
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@types/three": "^0.184.0",
    "@webgpu/types": "^0.1.74",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.0"
  }
}
